# =============================================================================
# HireLens — Environment Variables Configuration
# =============================================================================
# Note: All keys are OPTIONAL. HireLens operates with deterministic algorithms
# and fallback engines out-of-the-box. Supplying an LLM API key enables
# progressive AI enrichment for implementation plans and workflow automation steps.

# -----------------------------------------------------------------------------
# LLM Providers (Choose one or both for AI Task Enrichment)
# -----------------------------------------------------------------------------
# Google Gemini API Key (Recommended for high speed and low latency)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative provider for GPT-4o-mini enrichment)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Generic LLM API Key (Fallback if using custom gateways or proxies)
# LLM_API_KEY=your_generic_api_key_here

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
